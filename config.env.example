# Settings for docker-compose.qlever.yml. Copy to config.env and edit.

# Directory with the downloaded .nq files (mounted read-only)
NQ_INPUT_DIR=/path/to/gemea/nq

# QLever index directory; must be writable by UID:GID below
INDEX_DIR=/path/to/qlever-index

# Run QLever as this user (use `id -u` and `id -g`)
UID=1000
GID=1000

# Index name and input files
INDEX_NAME=gemea
NQ_INPUT_GLOB=*.nq

# Memory for the index build
INDEX_MEMORY=10G

# QLever server limits (hosted deployment values; lower them for a single sector)
QLEVER_MEMORY=50G
QLEVER_CACHE=15G
QLEVER_CACHE_ENTRY=5G
QLEVER_THREADS=8
QLEVER_TIMEOUT=60s

# Ports, bound to 127.0.0.1 only
QLEVER_PORT=2343
SHMARQL_PORT=2342
MCPO_PORT=2344
